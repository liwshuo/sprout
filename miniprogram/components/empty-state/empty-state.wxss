/* components/empty-state/empty-state.wxss */
.es-card {
  text-align: center;
  padding: 80rpx 40rpx;
}
.es-emoji {
  font-size: 80rpx;
  display: inline-block;
  margin-bottom: 24rpx;
}
.es-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2E2722;
  margin-bottom: 12rpx;
}
.es-subtitle {
  font-size: 26rpx;
  line-height: 1.6;
  margin-bottom: 24rpx;
  padding: 0 20rpx;
}
.es-action {
  display: inline-block;
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  background: #FF8C42;
  color: #fff;
  font-size: 26rpx;
}
