<!-- pages/mine/mine.wxml —— 我的：一体主卡 + 统计卡 + iOS 风格功能列表 -->
<view class="page-container">

  <!-- ① 顶部一体主卡：孩子主区 + 分割线 + 家长副区 -->
  <view class="child-main-card">

    <!-- 孩子主区 -->
    <block wx:if="{{children.length > 0}}">
      <view class="child-main-area">
        <view class="child-avatar">
          <image wx:if="{{activeChild._avatarUrl}}" src="{{activeChild._avatarUrl}}" class="child-avatar-img" mode="aspectFill" />
          <text wx:else class="child-avatar-emoji">{{activeChild._avatarEmoji || '👶'}}</text>
        </view>
        <view class="child-info">
          <view class="child-name ellipsis">{{activeChild._displayName || activeChild.name || '宝贝'}}</view>
          <view class="child-meta" wx:if="{{activeChild._ageText || activeChild._grade}}">
            <text wx:if="{{activeChild._ageText}}">{{activeChild._ageText}}</text>
            <text wx:if="{{activeChild._ageText && activeChild._grade}}"> · </text>
            <text wx:if="{{activeChild._grade}}">{{activeChild._grade}}</text>
          </view>
        </view>
        <view class="card-actions">
          <view class="action-btn" catchtap="onEditChild">✏️ 编辑</view>
          <view class="action-btn" catchtap="openAddChild">+ 添加</view>
        </view>
      </view>
      <!-- 多孩子：右下角切换 -->
      <view class="switch-row" wx:if="{{children.length > 1}}">
        <view class="switch-btn" catchtap="onSwitchChild">切换孩子 ▼</view>
      </view>
    </block>

    <!-- 无孩子引导 -->
    <view wx:else class="child-empty" catchtap="openAddChild">还没有孩子档案，点这里添加 +</view>

    <!-- 分割线 -->
    <view class="card-divider"></view>

    <!-- 家长副区（无 emoji；称谓行点击直接选角色，手机号为独立按钮） -->
    <view class="parent-area">
      <view class="parent-label-row" bindtap="onParentRowTap">
        <text class="parent-label {{parentLabelSet ? '' : 'parent-label-guide'}}">{{parentLabel || (isLoggedIn ? '我是 Ta 的...' : '登录后绑定家长角色')}}</text>
        <text wx:if="{{!parentLabelSet}}" class="parent-label-arrow">  {{isLoggedIn ? '选一下 →' : '登录 →'}}</text>
      </view>
      <view wx:if="{{isLoggedIn}}" class="parent-phone-btn" catchtap="onBindPhone">{{phoneTail ? '尾号 ' + phoneTail : '绑手机号'}}</view>
    </view>
  </view>

  <!-- ② 统计双列卡 -->
  <view class="stats-card">
    <view class="stat-col">
      <view class="stat-number">{{stats.records}}</view>
      <view class="stat-label">成长记录</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-col">
      <view class="stat-number">{{stats.books}}</view>
      <view class="stat-label">已读完</view>
    </view>
  </view>

  <!-- ③ 功能菜单（iOS 风格纯列表） -->
  <view class="list-section">
    <view class="list-item" bindtap="goTodo">
      <view class="list-item-icon icon-orange">📝</view>
      <view class="list-item-label">待办</view>
      <view class="list-item-arrow">›</view>
    </view>
    <view class="list-divider"></view>
    <view class="list-item" bindtap="goArchive">
      <view class="list-item-icon icon-blue">📁</view>
      <view class="list-item-label">成长档案</view>
      <view class="list-item-arrow">›</view>
    </view>
    <view class="list-divider"></view>
    <view class="list-item" bindtap="goReport">
      <view class="list-item-icon icon-orange">📊</view>
      <view class="list-item-label">本周成长周报</view>
      <view class="list-item-arrow">›</view>
    </view>
    <view class="list-divider"></view>
    <view class="list-item" bindtap="goCloudSync">
      <view class="list-item-icon icon-green">☁️</view>
      <view class="list-item-label">云同步</view>
      <view class="list-item-arrow">›</view>
    </view>
    <view class="list-divider-major"></view>
    <view class="list-item" bindtap="goSettings">
      <view class="list-item-icon icon-gray">⚙️</view>
      <view class="list-item-label">设置</view>
      <view class="list-item-arrow">›</view>
    </view>
    <view wx:if="{{isLoggedIn}}" class="list-divider"></view>
    <view wx:if="{{isLoggedIn}}" class="list-item list-item-danger" bindtap="onLogout">
      <view class="list-item-icon icon-gray">🚪</view>
      <view class="list-item-label">退出登录</view>
    </view>
  </view>

  <!-- ④ 页脚 -->
  <view class="page-footer">萌芽成长册 · 记录每一次成长</view>
</view>

<!-- ⑤ 弹层区 -->

<!-- 添加 / 编辑孩子弹层 -->
<view class="mask" wx:if="{{showChildSheet}}" bindtap="closeAddChild"></view>
<view class="sheet" wx:if="{{showChildSheet}}" catchtap>
  <view class="sheet-title">{{editingChildUuid ? '编辑宝宝信息' : '添加宝宝'}}</view>
  <!-- 头像选择（弹层内） -->
  <view class="form-avatar-row" bindtap="onFormAvatarTap">
    <image
      wx:if="{{childForm._avatarTempPath}}"
      src="{{childForm._avatarTempPath}}"
      class="form-avatar-img"
    />
    <view wx:elif="{{childForm.avatarFileId && formAvatarUrl}}" class="form-avatar-img-wrap">
      <image src="{{formAvatarUrl}}" class="form-avatar-img" />
    </view>
    <view wx:else class="form-avatar-placeholder">
      {{childForm.gender === 'boy' ? '👦' : childForm.gender === 'girl' ? '👧' : '👶'}}
    </view>
    <view class="form-avatar-hint">点击换头像</view>
  </view>
  <input class="sheet-input" value="{{childForm.name}}" placeholder="宝宝叫什么呢？大名小名都可以" placeholder-class="ph" bindinput="onChildInput" />
  <view class="sheet-field-label">性别</view>
  <view class="gender-chips">
    <view class="chip {{childForm.gender === 'boy' ? 'chip-active' : ''}}" bindtap="onGenderSelect" data-gender="boy">👦 男孩</view>
    <view class="chip {{childForm.gender === 'girl' ? 'chip-active' : ''}}" bindtap="onGenderSelect" data-gender="girl">👧 女孩</view>
    <view class="chip {{childForm.gender === 'unknown' ? 'chip-active' : ''}}" bindtap="onGenderSelect" data-gender="unknown">暂不填</view>
  </view>
  <view class="row-between sheet-field">
    <view class="sheet-field-label">出生日期</view>
    <picker mode="date" value="{{childForm.birthDate}}" bindchange="onBirthChange">
      <view class="picker-val">{{childForm.birthDate || '请选择'}} ›</view>
    </picker>
  </view>
  <view class="row sheet-actions">
    <view class="btn-ghost sheet-btn" bindtap="closeAddChild">取消</view>
    <view class="btn-primary sheet-btn" bindtap="saveChild">保存</view>
  </view>
</view>

<!-- 绑定手机号弹层（getPhoneNumber 必须由 button 触发，故单独弹层承接） -->
<view class="mask" wx:if="{{showPhoneSheet}}" bindtap="closePhoneSheet"></view>
<view class="sheet" wx:if="{{showPhoneSheet}}" catchtap>
  <view class="sheet-title">绑定 / 更换手机号</view>
  <view class="phone-sheet-desc">用于账号找回与多端同步</view>
  <button class="btn-primary phone-auth-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhone">微信授权绑定手机号</button>
  <view class="btn-ghost sheet-btn phone-cancel-btn" bindtap="closePhoneSheet">取消</view>
</view>

<!-- 年级确认弹层 -->
<view class="mask" wx:if="{{showGradeConfirm}}" bindtap="onGradeConfirmOk"></view>
<view class="sheet" wx:if="{{showGradeConfirm}}" catchtap>
  <view class="sheet-title">📚 年级确认</view>
  <view class="grade-confirm-text">根据生日推测 Ta 是<text class="text-primary">{{gradeConfirmText}}</text>，对吗？</view>
  <view class="row sheet-actions">
    <view class="btn-ghost sheet-btn" bindtap="onGradeConfirmEdit">✏️ 修改</view>
    <view class="btn-primary sheet-btn" bindtap="onGradeConfirmOk">✅ 对的</view>
  </view>
</view>

<!-- 年级手动选择 picker 弹层 -->
<view class="mask" wx:if="{{showGradePicker}}" bindtap="onGradePickerCancel"></view>
<view class="sheet" wx:if="{{showGradePicker}}" catchtap>
  <view class="sheet-title">选择年级</view>
  <picker-view
    class="grade-picker-view"
    value="{{[gradePickerIndex]}}"
    bindchange="onGradePickerChange"
  >
    <picker-view-column>
      <view wx:for="{{gradePickerRange}}" wx:key="*this" class="picker-item">{{item}}</view>
    </picker-view-column>
  </picker-view>
  <view class="row sheet-actions">
    <view class="btn-ghost sheet-btn" bindtap="onGradePickerCancel">取消</view>
    <view class="btn-primary sheet-btn" bindtap="onGradePickerConfirm">确认</view>
  </view>
</view>
