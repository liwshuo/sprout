/* pages/mine/mine.wxss —— 我的：一体主卡 + 统计卡 + iOS 风格功能列表（暖橙马卡龙） */

/* ============ 整页容器 ============ */
.page-container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #FFF8F3;
}

/* ============ ① 顶部一体主卡 ============ */
.child-main-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(255, 140, 66, 0.08);
  margin-bottom: 24rpx;
}

/* 未登录引导 */
.login-guide {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 12rpx 12rpx;
}
.login-guide-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2E2722;
}
.login-guide-sub {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #9A8F86;
}
.login-guide-btn {
  margin-top: 28rpx;
  min-width: 240rpx;
  padding: 18rpx 44rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FF9D5C, #FF7A2F);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

/* 孩子主区 */
.child-main-area {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.child-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #FFF3E8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.child-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
.child-avatar-emoji {
  font-size: 60rpx;
  line-height: 1;
}
.child-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-left: 24rpx;
}
.child-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #333;
}
.child-meta {
  font-size: 26rpx;
  color: #999;
}
/* 右上角胶囊按钮组 */
.card-actions {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 12rpx;
  flex-shrink: 0;
}
.action-btn {
  font-size: 24rpx;
  color: #FF8C42;
  background: #FFF3E8;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  line-height: 1.4;
}
/* 切换孩子 */
.switch-row {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  margin-top: 20rpx;
}
.switch-btn {
  font-size: 26rpx;
  color: #FF8C42;
  background: #FFF3E8;
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
}
/* 无孩子引导 */
.child-empty {
  font-size: 28rpx;
  color: #FF8C42;
  text-align: center;
  padding: 28rpx 0;
}

/* 分割线 */
.card-divider {
  height: 1px;
  background: #F0F0F0;
  margin: 24rpx 0;
}

/* 家长副区（整行点击，两端对齐，无 emoji） */
.parent-area {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  min-height: 60rpx;
}
/* 称谓行：flex:1 占满左侧，点击区域足够大 */
.parent-label-row {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 8rpx 0;
  min-height: 44rpx;
}
.parent-label {
  font-size: 28rpx;
  color: #555;
  font-weight: 500;
}
.parent-label-guide {
  color: #FF8C42;
}
.parent-label-arrow {
  color: #FFB07C;
  font-size: 26rpx;
}
.parent-hint {
  font-size: 24rpx;
  color: #BBB;
  margin-left: 16rpx;
  flex-shrink: 0;
}
/* 独立「绑手机号 / 尾号」按钮 */
.parent-phone-btn {
  font-size: 24rpx;
  color: #FF8C42;
  background: #FFF3E8;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
  line-height: 1.4;
}

/* ============ ② 统计双列卡 ============ */
.stats-card {
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(255, 140, 66, 0.08);
  margin-bottom: 24rpx;
  padding: 36rpx 0;
  display: flex;
  flex-direction: row;
  align-items: center;
}
.stat-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.stat-number {
  font-size: 52rpx;
  font-weight: 700;
  color: #FF8C42;
  line-height: 1.1;
}
.stat-label {
  font-size: 24rpx;
  color: #999;
}
.stat-divider {
  width: 1px;
  height: 64rpx;
  background: #F0F0F0;
}

/* ============ ③ 功能菜单（iOS 风格纯列表） ============ */
.list-section {
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(255, 140, 66, 0.08);
  padding: 0 28rpx;
  margin-bottom: 24rpx;
}
.list-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 96rpx;
}
.list-item-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
}
.icon-blue { background: #E8F1FF; }
.icon-orange { background: #FFF0E3; }
.icon-green { background: #E6F7EE; }
.icon-gray { background: #F0F0F2; }
.list-item-label {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  color: #333;
  margin-left: 24rpx;
}
.list-item-arrow {
  font-size: 40rpx;
  color: #CCC;
  flex-shrink: 0;
}
/* 项间细分割线（缩进对齐文字，留出图标宽度） */
.list-divider {
  height: 1px;
  background: #F5F5F5;
  margin-left: 88rpx;
}
/* 更明显的分组分割线（设置项前） */
.list-divider-major {
  height: 1px;
  background: #ECECEC;
}

/* ============ ④ 页脚 ============ */
.page-footer {
  text-align: center;
  font-size: 24rpx;
  color: #BBB;
  margin-top: 24rpx;
}

/* ============ ⑤ 弹层内内容样式（mask/sheet 由 bottom-sheet 组件承载） ============ */
.sheet-input {
  background: var(--bg);
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 30rpx;
  margin-bottom: 20rpx;
}
.ph {
  color: var(--ink-weak);
}
.sheet-field {
  padding: 20rpx 8rpx;
  border-bottom: 2rpx solid var(--line);
}
.sheet-field-label {
  font-size: 28rpx;
  font-weight: 600;
}
.picker-val {
  font-size: 30rpx;
  color: var(--primary-dark);
}
.sheet-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
}
.sheet-btn:first-child {
  margin-right: 20rpx;
}

/* 绑定手机号弹层 */
.phone-sheet-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 28rpx;
}
.phone-auth-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 32rpx;
  text-align: center;
}
.phone-cancel-btn {
  margin-top: 20rpx;
  border-radius: 999rpx;
}

/* 性别 chip */
.gender-chips {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-top: 8rpx;
}
.chip {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #f5f5f5;
  font-size: 26rpx;
  color: #555;
  border: 2rpx solid transparent;
}
.chip-active {
  background: #fff3e8;
  color: #ff7a2e;
  border-color: #ff7a2e;
}

/* 年级确认文字 */
.grade-confirm-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.7;
  margin: 16rpx 0 32rpx;
}

/* 年级 picker */
.grade-picker-view {
  height: 400rpx;
  margin: 16rpx 0;
}
.picker-item {
  line-height: 80rpx;
  text-align: center;
  font-size: 30rpx;
}

/* 弹层内头像选择 */
.form-avatar-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 16rpx;
}
.form-avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  object-fit: cover;
}
.form-avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: #FFF3E0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}
.form-avatar-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #BDBDBD;
}

/* 退出登录 - 危险操作红色文字 */
.list-item-danger .list-item-label {
  color: #FF4D4F;
}

/* ==================== 家庭共享 ==================== */
.icon-pink { background: #FFE9EF; }

/* 列表项右侧副文案（家庭共享入口用） */
.list-item-sub {
  font-size: 24rpx;
  color: #B0A79E;
  margin-right: 12rpx;
  flex-shrink: 0;
}

/* 成员管理弹层 */
.members-sheet { padding: 8rpx 4rpx 16rpx; }
.members-subtitle {
  font-size: 26rpx;
  color: #9A8F82;
  margin-bottom: 16rpx;
}
.members-loading {
  text-align: center;
  color: #B0A79E;
  font-size: 28rpx;
  padding: 48rpx 0;
}
.members-list { margin-bottom: 8rpx; }
.member-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F2EDE7;
}
.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #F5F0EA;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}
.member-avatar-img { width: 100%; height: 100%; }
.member-avatar-emoji { font-size: 36rpx; }
.member-info { flex: 1; min-width: 0; margin-left: 20rpx; }
.member-name {
  font-size: 30rpx;
  color: #333;
  display: flex;
  align-items: center;
}
.member-meta { font-size: 24rpx; color: #B0A79E; margin-top: 4rpx; }
.member-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-left: 10rpx;
  flex-shrink: 0;
}
.member-tag-self { background: #E8F1FF; color: #3E8CE0; }
.member-tag-owner { background: #FFF0E3; color: #E5702A; }
.member-remove {
  font-size: 26rpx;
  color: #FF4D4F;
  padding: 8rpx 20rpx;
  flex-shrink: 0;
}

.members-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 28rpx;
}
.invite-btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  text-align: center;
  font-size: 30rpx;
  margin: 0;
}
.invite-btn::after { border: none; }
.invite-btn-primary { background: #FF8C42; color: #fff; }
.invite-btn-ghost {
  background: #FFF3EB;
  color: #E5702A;
  border: 1rpx solid #FFD9BE;
}
.invite-btn-icon { margin-right: 8rpx; }
.members-tip {
  font-size: 22rpx;
  color: #B0A79E;
  text-align: center;
  margin-top: 20rpx;
  line-height: 1.5;
}
.member-leave {
  margin-top: 28rpx;
  text-align: center;
  font-size: 28rpx;
  color: #FF4D4F;
  padding: 16rpx 0;
}

/* 邀请二维码弹层 */
.qr-sheet {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 16rpx;
}
.qr-loading { color: #B0A79E; font-size: 28rpx; padding: 80rpx 0; }
.qr-image {
  width: 440rpx;
  height: 440rpx;
  background: #fff;
  border-radius: 16rpx;
}
.qr-code-text {
  margin-top: 20rpx;
  font-size: 30rpx;
  color: #333;
  letter-spacing: 4rpx;
  font-weight: 600;
}
.qr-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9A8F82;
  text-align: center;
  padding: 0 32rpx;
  line-height: 1.5;
}
.qr-save-btn {
  margin-top: 28rpx;
  padding: 14rpx 48rpx;
  background: #FFF3EB;
  color: #E5702A;
  border-radius: 40rpx;
  font-size: 28rpx;
}
