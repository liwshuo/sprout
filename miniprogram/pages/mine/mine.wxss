/* pages/mine/mine.wxss —— 我的 */
.user-card {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--primary-soft);
  font-size: 52rpx;
  line-height: 96rpx;
  text-align: center;
  margin-right: 24rpx;
}
.user-name {
  font-size: 34rpx;
  font-weight: 700;
}
.user-sub {
  font-size: 24rpx;
  margin-top: 6rpx;
}
.login-btn {
  min-width: 140rpx;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 28rpx;
  padding: 0 28rpx;
  margin: 0;
}

/* 当前孩子主卡（暖橙马卡龙：白卡 + 大圆角 + 柔和阴影） */
.child-main-card {
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin: 24rpx 28rpx 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}
.child-card-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-start;
}
.child-card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
}
.child-card-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}
.child-card-action-btn {
  font-size: 26rpx;
  color: #FF8C42;
  padding: 4rpx 12rpx;
}
.child-card-body {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 16rpx;
  gap: 24rpx;
}
.child-avatar-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50rpx;
  overflow: hidden;
  background: #FFF3E8;
  display: flex;
  align-items: center;
  justify-content: center;
}
.child-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50rpx;
}
.child-avatar-emoji {
  font-size: 56rpx;
}
.child-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.child-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}
.child-stats {
  font-size: 24rpx;
  color: #aaa;
}
.child-switch-row {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  margin-top: 16rpx;
}
.child-switch-btn {
  font-size: 26rpx;
  color: #FF8C42;
}
.child-empty-tip {
  font-size: 28rpx;
  color: #aaa;
  text-align: center;
  padding: 32rpx;
}

.stat-card {
  display: flex;
  align-items: center;
}
.stat-item {
  flex: 1;
  text-align: center;
}
.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--primary);
}
.stat-label {
  font-size: 24rpx;
  margin-top: 6rpx;
}
.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: var(--line);
}

.menu-card {
  padding: 8rpx 28rpx;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
}
.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}
.menu-text {
  font-size: 30rpx;
}
.menu-arrow {
  color: var(--ink-weak);
  font-size: 40rpx;
}
.menu-divider {
  height: 2rpx;
  background: var(--line);
}

.footer {
  text-align: center;
  font-size: 24rpx;
  margin-top: 40rpx;
}

/* 弹层 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 30;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  z-index: 31;
}
.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 28rpx;
}
.sheet-input {
  background: var(--bg);
  border-radius: var(--radius);
  padding: 24rpx;
  font-size: 30rpx;
  margin-bottom: 20rpx;
}
.ph {
  color: var(--ink-weak);
}
.sheet-field {
  padding: 20rpx 8rpx;
  border-bottom: 2rpx solid var(--line);
}
.sheet-field-label {
  font-size: 28rpx;
  font-weight: 600;
}
.picker-val {
  font-size: 30rpx;
  color: var(--primary-dark);
}
.sheet-actions {
  margin-top: 32rpx;
}
.sheet-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
}
.sheet-btn:first-child {
  margin-right: 20rpx;
}

/* 孩子信息副文字（年龄 / 年级） */
.child-meta {
  font-size: 26rpx;
  color: #888;
  margin-top: 4rpx;
}

/* 性别 chip */
.gender-chips {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.chip {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #f5f5f5;
  font-size: 26rpx;
  color: #555;
  border: 2rpx solid transparent;
}

.chip-active {
  background: #fff3e8;
  color: #ff7a2e;
  border-color: #ff7a2e;
}

/* 年级确认文字 */
.grade-confirm-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.7;
  margin: 16rpx 0 32rpx;
}

/* 年级 picker */
.grade-picker-view {
  height: 400rpx;
  margin: 16rpx 0;
}
.picker-item {
  line-height: 80rpx;
  text-align: center;
  font-size: 30rpx;
}

/* 弹层内头像选择 */
.form-avatar-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 16rpx;
}
.form-avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  object-fit: cover;
}
.form-avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: #FFF3E0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}
.form-avatar-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #BDBDBD;
}
