/* pages/mine/mine.wxss —— 我的：一体主卡 + 统计卡 + iOS 风格功能列表（暖橙马卡龙） */

/* ============ 整页容器 ============ */
.page-container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #FFF8F3;
}

/* ============ ① 顶部一体主卡 ============ */
.child-main-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(255, 140, 66, 0.08);
  margin-bottom: 24rpx;
}

/* 孩子主区 */
.child-main-area {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.child-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #FFF3E8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.child-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
.child-avatar-emoji {
  font-size: 60rpx;
  line-height: 1;
}
.child-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-left: 24rpx;
}
.child-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #333;
}
.child-meta {
  font-size: 26rpx;
  color: #999;
}
/* 右上角胶囊按钮组 */
.card-actions {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 12rpx;
  flex-shrink: 0;
}
.action-btn {
  font-size: 24rpx;
  color: #FF8C42;
  background: #FFF3E8;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  line-height: 1.4;
}
/* 切换孩子 */
.switch-row {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  margin-top: 20rpx;
}
.switch-btn {
  font-size: 26rpx;
  color: #FF8C42;
  background: #FFF3E8;
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
}
/* 无孩子引导 */
.child-empty {
  font-size: 28rpx;
  color: #FF8C42;
  text-align: center;
  padding: 28rpx 0;
}

/* 分割线 */
.card-divider {
  height: 1px;
  background: #F0F0F0;
  margin: 24rpx 0;
}

/* 家长副区（整行点击，两端对齐，无 emoji） */
.parent-area {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  min-height: 60rpx;
}
.parent-label {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #555;
  font-weight: 500;
  padding: 8rpx 0;
  min-height: 44rpx;
  display: flex;
  align-items: center;
}
.parent-label-guide {
  color: #FF8C42;
}
.parent-label-arrow {
  color: #FFB07C;
  font-size: 26rpx;
}
.parent-hint {
  font-size: 24rpx;
  color: #BBB;
  margin-left: 16rpx;
  flex-shrink: 0;
}
/* 独立「绑手机号 / 尾号」按钮 */
.parent-phone-btn {
  font-size: 24rpx;
  color: #FF8C42;
  background: #FFF3E8;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
  line-height: 1.4;
}

/* ============ ② 统计双列卡 ============ */
.stats-card {
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(255, 140, 66, 0.08);
  margin-bottom: 24rpx;
  padding: 36rpx 0;
  display: flex;
  flex-direction: row;
  align-items: center;
}
.stat-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.stat-number {
  font-size: 52rpx;
  font-weight: 700;
  color: #FF8C42;
  line-height: 1.1;
}
.stat-label {
  font-size: 24rpx;
  color: #999;
}
.stat-divider {
  width: 1px;
  height: 64rpx;
  background: #F0F0F0;
}

/* ============ ③ 功能菜单（iOS 风格纯列表） ============ */
.list-section {
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(255, 140, 66, 0.08);
  padding: 0 28rpx;
  margin-bottom: 24rpx;
}
.list-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 96rpx;
}
.list-item-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
}
.icon-blue { background: #E8F1FF; }
.icon-orange { background: #FFF0E3; }
.icon-green { background: #E6F7EE; }
.icon-gray { background: #F0F0F2; }
.list-item-label {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  color: #333;
  margin-left: 24rpx;
}
.list-item-arrow {
  font-size: 40rpx;
  color: #CCC;
  flex-shrink: 0;
}
/* 项间细分割线（缩进对齐文字，留出图标宽度） */
.list-divider {
  height: 1px;
  background: #F5F5F5;
  margin-left: 88rpx;
}
/* 更明显的分组分割线（设置项前） */
.list-divider-major {
  height: 1px;
  background: #ECECEC;
}

/* ============ ④ 页脚 ============ */
.page-footer {
  text-align: center;
  font-size: 24rpx;
  color: #BBB;
  margin-top: 24rpx;
}

/* ============ ⑤ 弹层通用 ============ */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 30;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  z-index: 31;
}
.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 28rpx;
}
.sheet-input {
  background: var(--bg);
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 30rpx;
  margin-bottom: 20rpx;
}
.ph {
  color: var(--ink-weak);
}
.sheet-field {
  padding: 20rpx 8rpx;
  border-bottom: 2rpx solid var(--line);
}
.sheet-field-label {
  font-size: 28rpx;
  font-weight: 600;
}
.picker-val {
  font-size: 30rpx;
  color: var(--primary-dark);
}
.sheet-actions {
  margin-top: 32rpx;
}
.sheet-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
}
.sheet-btn:first-child {
  margin-right: 20rpx;
}

/* 绑定手机号弹层 */
.phone-sheet-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 28rpx;
}
.phone-auth-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 32rpx;
  text-align: center;
}
.phone-cancel-btn {
  margin-top: 20rpx;
  border-radius: 999rpx;
}

/* 性别 chip */
.gender-chips {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-top: 8rpx;
}
.chip {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #f5f5f5;
  font-size: 26rpx;
  color: #555;
  border: 2rpx solid transparent;
}
.chip-active {
  background: #fff3e8;
  color: #ff7a2e;
  border-color: #ff7a2e;
}

/* 年级确认文字 */
.grade-confirm-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.7;
  margin: 16rpx 0 32rpx;
}

/* 年级 picker */
.grade-picker-view {
  height: 400rpx;
  margin: 16rpx 0;
}
.picker-item {
  line-height: 80rpx;
  text-align: center;
  font-size: 30rpx;
}

/* 弹层内头像选择 */
.form-avatar-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 16rpx;
}
.form-avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  object-fit: cover;
}
.form-avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: #FFF3E0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}
.form-avatar-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #BDBDBD;
}
