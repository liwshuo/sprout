<!-- pages/records/index.wxml - 记录列表 -->
<view class="container">
  <view class="page-title">成长记录</view>
  <view class="card" wx:if="{{records.length === 0}}">
    <view class="empty">暂无记录，快去添加第一条成长记录吧～</view>
  </view>
  <view class="card" wx:for="{{records}}" wx:key="id">
    <view>{{item.title}}</view>
  </view>
</view>
