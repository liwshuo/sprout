/* pages/todo/todo.wxss —— 孩子待办清单（暖橙马卡龙 · 大字号 · 大圆角） */

/* ===== 顶部孩子过滤 chip ===== */
.child-chip-row {
  white-space: nowrap;
  margin: 4rpx 0 20rpx;
}
.child-chip {
  display: inline-block;
  padding: 12rpx 32rpx;
  margin-right: 16rpx;
  border-radius: var(--radius-pill);
  background: var(--card);
  color: var(--ink-sub);
  font-size: 28rpx;
  box-shadow: var(--shadow);
}
.child-chip-active {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: #fff;
  font-weight: 600;
  box-shadow: var(--shadow-primary);
}

/* ===== 完成进度卡 ===== */
.progress-card {
  padding: 24rpx 28rpx;
}
.progress-text {
  margin-bottom: 16rpx;
}
.progress-done {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary);
}
.progress-total {
  font-size: 26rpx;
  color: var(--ink-sub);
}
.progress-track {
  height: 16rpx;
  border-radius: var(--radius-pill);
  background: var(--primary-soft);
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  border-radius: var(--radius-pill);
  background: linear-gradient(135deg, var(--primary-light), var(--primary));
  transition: width 0.3s ease;
}

/* ===== 分类筛选 tab ===== */
.filter-row {
  white-space: nowrap;
  margin: 8rpx 0 20rpx;
}
.filter-chip {
  display: inline-block;
  padding: 12rpx 34rpx;
  margin-right: 16rpx;
  border-radius: var(--radius-pill);
  background: var(--card);
  color: var(--ink-sub);
  font-size: 28rpx;
  box-shadow: var(--shadow);
}
.filter-chip-active {
  background: var(--primary);
  color: #fff;
  font-weight: 600;
}

/* ===== 待办卡片 ===== */
.todo-list {
  margin-top: 4rpx;
}
.todo-card {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
}
.todo-card-done {
  opacity: 0.6;
}

/* 勾选圈 */
.check {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 4rpx solid var(--primary-light);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.check-on {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  border-color: var(--primary);
}
.check-mark {
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
}

/* 分类色条 */
.todo-line {
  width: 8rpx;
  align-self: stretch;
  border-radius: 8rpx;
  margin: 0 20rpx;
}

.todo-body {
  min-width: 0;
}
.todo-title-row {
  display: flex;
  align-items: center;
}
.todo-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}
.todo-title-done {
  text-decoration: line-through;
  color: var(--ink-sub);
}
.todo-meta {
  font-size: 24rpx;
  margin-top: 10rpx;
}
.cat-tag {
  font-weight: 600;
}
.due-tag {
  color: var(--ink-sub);
}
.due-overdue {
  color: #FF4D4F;
  font-weight: 600;
}
.todo-remark {
  font-size: 24rpx;
  color: var(--ink-sub);
  margin-top: 8rpx;
}
.del-btn {
  font-size: 24rpx;
  color: var(--ink-weak);
  padding: 8rpx 12rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.list-footer {
  height: 140rpx;
}

/* ===== 弹层自定义元素 ===== */
.sheet-input {
  background: #F5EFE9;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 30rpx;
  margin-bottom: 8rpx;
  width: 100%;
  box-sizing: border-box;
}
.sheet-textarea {
  background: #F5EFE9;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  margin-top: 16rpx;
  width: 100%;
  height: 140rpx;
  box-sizing: border-box;
}
.ph {
  color: #B0A79E;
}
.sheet-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 8rpx;
  border-bottom: 2rpx solid #EFE7DE;
}
.sheet-field-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #2E2722;
}
.row-label {
  display: block;
  padding: 20rpx 8rpx 8rpx;
}
.picker-val {
  font-size: 30rpx;
  color: var(--primary);
}
.due-clear {
  font-size: 24rpx;
  color: var(--ink-sub);
  margin-left: 20rpx;
}

/* 分类 chip（弹层内） */
.cat-chip-row {
  display: flex;
  flex-wrap: wrap;
  margin: 8rpx 0 8rpx;
}
.cat-chip {
  padding: 14rpx 28rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: var(--radius-pill);
  background: var(--bg);
  font-size: 28rpx;
  color: var(--ink-sub);
}
.cat-chip-active {
  font-weight: 600;
}

/* ===== 骨架屏 ===== */
.sk-item {
  background: var(--card);
  border-radius: var(--radius);
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}
.sk-line {
  height: 24rpx;
  border-radius: 8rpx;
  background: var(--line);
  margin: 12rpx 0;
}
.sk-line.short {
  width: 40%;
}
