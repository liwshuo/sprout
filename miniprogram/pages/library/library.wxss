/* pages/library/library.wxss —— 精选书库（暖橙马卡龙 · 大圆角 · 卡通温馨） */

/* ============ 搜索栏 ============ */
.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: var(--radius-pill);
  padding: 16rpx 28rpx;
  box-shadow: var(--shadow);
  margin-bottom: 24rpx;
}
.search-icon {
  font-size: 30rpx;
  margin-right: 14rpx;
  opacity: 0.7;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}
.search-ph {
  color: var(--ink-weak);
}
.search-clear {
  font-size: 26rpx;
  color: var(--ink-weak);
  padding: 0 8rpx;
}

/* ============ 年龄段 Tab（横向滚动） ============ */
.age-tabs {
  white-space: nowrap;
  margin-bottom: 28rpx;
}
.age-tab {
  display: inline-block;
  padding: 14rpx 30rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: var(--ink-sub);
  background: #fff;
  border-radius: var(--radius-pill);
  box-shadow: var(--shadow);
}
.age-tab.active {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: #fff;
  font-weight: 600;
}

/* ============ 书卡网格（两列） ============ */
.book-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.book-card {
  width: 48%;
  margin-bottom: 32rpx;
}
.cover {
  position: relative;
  width: 100%;
  height: 340rpx;
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow);
  background: var(--primary-soft);
}
.cover-img {
  width: 100%;
  height: 100%;
}
.cover-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--primary-light), var(--primary-soft));
}
.cover-char {
  font-size: 72rpx;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}
/* 兜底色块按年龄段变色 */
.cover-fallback.age-03 { background: linear-gradient(135deg, #FFB6C9, #FFE1EA); }
.cover-fallback.age-36 { background: linear-gradient(135deg, var(--primary-light), var(--primary-soft)); }
.cover-fallback.age-69 { background: linear-gradient(135deg, #9BE6D4, #D8F5EE); }
.cover-fallback.age-912 { background: linear-gradient(135deg, #A9D6F5, #DCEEFB); }

/* 系列角标（右上角） */
.series-flag {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  font-size: 20rpx;
  color: #fff;
  background: var(--primary);
  box-shadow: var(--shadow-primary);
}

.book-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 14rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.35;
  min-height: 76rpx;
}
.book-author {
  font-size: 22rpx;
  color: var(--ink-sub);
  margin-top: 4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ============ 徽标 ============ */
.badge-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
}
.badge {
  font-size: 20rpx;
  color: #fff;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  margin-right: 10rpx;
  margin-bottom: 6rpx;
}
.badge.age-03 { background: var(--pink); }
.badge.age-36 { background: var(--primary); }
.badge.age-69 { background: var(--mint); }
.badge.age-912 { background: var(--sky); }
.badge-type {
  background: var(--primary-soft);
  color: var(--primary-dark);
}

/* ============ 骨架屏 ============ */
.skeleton .sk-cover {
  width: 100%;
  height: 340rpx;
  border-radius: var(--radius);
  background: var(--line);
}
.skeleton .sk-line {
  height: 24rpx;
  border-radius: 8rpx;
  background: var(--line);
  margin-top: 16rpx;
}
.skeleton .sk-line.short {
  width: 50%;
}

/* ============ 弹层（底部抽屉） ============ */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 50;
  visibility: hidden;
  opacity: 0;
  transition: opacity 0.2s ease;
}
.mask.show {
  visibility: visible;
  opacity: 1;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  z-index: 51;
  max-height: 82vh;
  display: flex;
  flex-direction: column;
}
.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--line);
  margin: 0 auto 28rpx;
}
.sheet .btn-primary {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 32rpx;
  text-align: center;
  margin-top: 24rpx;
}

/* 单本详情 */
.detail {
  display: flex;
}
.detail-cover {
  width: 180rpx;
  height: 240rpx;
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow);
  flex-shrink: 0;
  background: var(--primary-soft);
}
.detail-main {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}
.detail-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
}
.detail-author {
  font-size: 24rpx;
  color: var(--ink-sub);
  margin-top: 8rpx;
}
.detail-desc {
  font-size: 26rpx;
  color: var(--ink-sub);
  line-height: 1.6;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: var(--bg);
  border-radius: var(--radius);
}

/* 系列面板 */
.series-head {
  margin-bottom: 12rpx;
}
.series-title {
  font-size: 34rpx;
  font-weight: 700;
}
.series-sub {
  font-size: 24rpx;
  color: var(--ink-sub);
  margin-top: 8rpx;
}
.vol-list {
  flex: 1;
  max-height: 52vh;
}
.vol-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 8rpx;
  border-bottom: 2rpx solid var(--line);
}
.vol-info {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}
.vol-idx {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary-dark);
  margin-right: 16rpx;
  white-space: nowrap;
}
.vol-name {
  font-size: 28rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.vol-add {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary-dark);
  background: var(--primary-soft);
  border-radius: var(--radius-pill);
  padding: 8rpx 28rpx;
  white-space: nowrap;
  margin-left: 16rpx;
}
.vol-add:active {
  opacity: 0.75;
}
