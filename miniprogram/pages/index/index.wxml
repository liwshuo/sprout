<!-- pages/index/index.wxml —— 日历首页（三源聚合） -->
<view class="container">
  <view class="row-between header">
    <view class="page-title">{{monthLabel}}</view>
    <view class="row month-switch">
      <view class="switch-btn" bindtap="prevMonth">‹</view>
      <view class="switch-btn" bindtap="nextMonth">›</view>
    </view>
  </view>

  <!-- 月历卡片 -->
  <view class="card calendar-card">
    <view class="week-row">
      <view class="week-cell text-sub" wx:for="{{weekHeaders}}" wx:key="*this">{{item}}</view>
    </view>
    <view class="day-grid">
      <view
        class="day-cell {{item.inMonth ? '' : 'muted'}} {{item.date === selectedDate ? 'selected' : ''}}"
        wx:for="{{cells}}"
        wx:key="date"
        data-date="{{item.date}}"
        bindtap="onTapDay"
      >
        <view class="day-num {{item.isToday ? 'today' : ''}}">{{item.day}}</view>
        <!-- 每天最多 3 个彩色圆点 -->
        <view class="dot-row">
          <view class="dot" wx:for="{{item.dots}}" wx:for-item="c" wx:key="*this" style="background:{{c}}"></view>
        </view>
      </view>
    </view>

    <!-- 图例 -->
    <view class="legend">
      <view class="legend-item" wx:for="{{legend}}" wx:key="label">
        <view class="legend-dot" style="background:{{item.color}}"></view>
        <text class="legend-text text-sub">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 当天事件 -->
  <view class="row-between section-head">
    <view class="section-title">{{selectedLabel}} · 当天安排</view>
    <view class="text-primary add-link" bindtap="goAdd">+ 记一笔</view>
  </view>

  <view class="empty card" wx:if="{{dayEvents.length === 0}}">
    <text class="empty-emoji">🌱</text>
    <view class="empty-text">这一天还没有安排，点上方「记一笔」开始吧</view>
  </view>

  <!-- 统一事件卡片列表（record / schedule / reading，按类型分色） -->
  <event-card wx:for="{{dayEvents}}" wx:key="sourceId" event="{{item}}" />
</view>

<view class="fab" bindtap="goAdd">＋</view>
