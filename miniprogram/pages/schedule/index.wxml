<!-- pages/schedule/index.wxml —— 课表：周网格总览 / 日视图；课程库拖拽排课 -->
<view class="container">
  <child-switcher />

  <!-- 标题 + 周/日切换 + 课程库入口 -->
  <view class="sched-toolbar">
    <view class="toolbar-titles">
      <view class="page-title">课程表</view>
      <view class="page-subtitle">从课程库长按拖到时间格排课 · 拖动课程块可调时间</view>
    </view>
    <view class="view-seg">
      <view class="seg-item {{viewMode === 'week' ? 'seg-on' : ''}}" data-mode="week" bindtap="onSwitchView">周</view>
      <view class="seg-item {{viewMode === 'day' ? 'seg-on' : ''}}" data-mode="day" bindtap="onSwitchView">日</view>
    </view>
  </view>

  <!-- 图例 + 课程库开关 -->
  <view class="legend">
    <view class="legend-item"><view class="legend-dot dot-school"></view>校内课</view>
    <view class="legend-item"><view class="legend-dot dot-hobby"></view>兴趣班</view>
    <view class="legend-lib {{showLibrary ? 'on' : ''}}" bindtap="toggleLibrary">📚 课程库{{showLibrary ? ' ▾' : ' ▸'}}</view>
  </view>

  <!-- ========== 周视图 ========== -->
  <scroll-view wx:if="{{viewMode === 'week'}}" class="week-scroll" scroll-x scroll-left="{{scrollLeft}}" bindscroll="onWeekScroll" enable-flex>
    <view class="grid">
      <view class="ghead">
        <view class="gcorner"></view>
        <view class="dhead {{c.isToday ? 'today' : ''}}" wx:for="{{week.cols}}" wx:for-item="c" wx:key="weekday">
          <view class="dhead-wd">周{{c.wd}}</view>
          <view class="dhead-dt">{{c.dateLabel}}</view>
        </view>
      </view>
      <view class="gbody" style="height:{{week.gridHeight}}rpx">
        <view class="timecol">
          <view class="th" wx:for="{{week.hours}}" wx:key="label" style="top:{{item.top}}rpx">{{item.label}}</view>
        </view>
        <view
          class="daycol {{c.isToday ? 'today' : ''}}"
          id="col-{{c.weekday}}"
          data-weekday="{{c.weekday}}"
          wx:for="{{week.cols}}"
          wx:for-item="c"
          wx:key="weekday"
        >
          <view class="hline" wx:for="{{week.lines}}" wx:for-item="ln" wx:key="*this" style="top:{{ln}}rpx"></view>
          <view class="drop-hint" wx:if="{{dropHint.show && dropHint.weekday === c.weekday}}" style="top:{{dropHint.top}}rpx;height:{{dropHint.height}}rpx">{{dropHint.timeText}}</view>
          <view
            class="ev {{ev.todayOff ? 'ev-off' : ''}}"
            wx:for="{{c.events}}"
            wx:for-item="ev"
            wx:key="uuid"
            style="top:{{ev.top}}rpx;height:{{ev.height}}rpx;background:{{ev.color}}"
            data-uuid="{{ev.uuid}}"
            bindtouchstart="onBlockTouchStart"
            catchtouchmove="onBlockTouchMove"
            bindtouchend="onBlockTouchEnd"
            bindtouchcancel="onBlockTouchEnd"
          >
            <view class="ev-nm">{{ev.courseName}}</view>
            <view class="ev-tm">{{ev.startTime}}-{{ev.endTime}}</view>
            <view class="ev-off" wx:if="{{ev.todayOff}}">今日停</view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- ========== 日视图 ========== -->
  <block wx:if="{{viewMode === 'day'}}">
    <view class="daytabs">
      <view
        class="daytab {{selectedWeekday === t.wd ? 'daytab-on' : ''}} {{t.isToday ? 'daytab-today' : ''}}"
        wx:for="{{weekTabs}}"
        wx:for-item="t"
        wx:key="wd"
        data-wd="{{t.wd}}"
        bindtap="onSelectDay"
      >周{{t.label}}</view>
    </view>
    <view class="day-empty" wx:if="{{!loading && day.events.length === 0}}">这一天暂无课程，展开课程库拖课过来</view>
    <view class="gbody day-body" style="height:{{day.gridHeight}}rpx">
      <view class="timecol">
        <view class="th" wx:for="{{day.hours}}" wx:key="label" style="top:{{item.top}}rpx">{{item.label}}</view>
      </view>
      <view class="daycol daycol-full" id="col-day" data-weekday="{{selectedWeekday}}">
        <view class="hline" wx:for="{{day.lines}}" wx:for-item="ln" wx:key="*this" style="top:{{ln}}rpx"></view>
        <view class="drop-hint" wx:if="{{dropHint.show && dropHint.weekday === selectedWeekday}}" style="top:{{dropHint.top}}rpx;height:{{dropHint.height}}rpx">{{dropHint.timeText}}</view>
        <view
          class="ev {{ev.todayOff ? 'ev-off' : ''}}"
          wx:for="{{day.events}}"
          wx:for-item="ev"
          wx:key="uuid"
          style="top:{{ev.top}}rpx;height:{{ev.height}}rpx;background:{{ev.color}}"
          data-uuid="{{ev.uuid}}"
          bindtouchstart="onBlockTouchStart"
          catchtouchmove="onBlockTouchMove"
          bindtouchend="onBlockTouchEnd"
          bindtouchcancel="onBlockTouchEnd"
        >
          <view class="ev-nm">{{ev.courseName}}</view>
          <view class="ev-tm">{{ev.startTime}}-{{ev.endTime}}</view>
          <view class="ev-off" wx:if="{{ev.todayOff}}">今日停</view>
        </view>
      </view>
    </view>
  </block>

  <view class="list-footer"></view>
</view>

<!-- 课程库面板（固定底部，长按 chip 拖到课表加课） -->
<view class="lib-panel {{showLibrary ? 'lib-open' : ''}}">
  <view class="lib-head">
    <view class="lib-tabs">
      <view class="lib-tab {{libCategory === 'school' ? 'lib-tab-on' : ''}}" data-cat="school" bindtap="switchLibCategory">校内</view>
      <view class="lib-tab {{libCategory === 'extra' ? 'lib-tab-on' : ''}}" data-cat="extra" bindtap="switchLibCategory">兴趣班</view>
    </view>
    <view class="lib-manage" bindtap="goCourseLibrary">管理 ›</view>
  </view>
  <view class="lib-tip">长按课程拖到课表松手加课（校内默认 40 分钟 / 兴趣班 60 分钟）</view>

  <block wx:if="{{hasTemplates}}">
    <scroll-view scroll-y class="lib-chips">
      <view
        class="chip"
        wx:for="{{courseLib[libCategory]}}"
        wx:key="templateId"
        data-name="{{item.name}}"
        data-type="{{item.type}}"
        data-color="{{item.color}}"
        data-tpl="{{item.templateId}}"
        bindtouchstart="onChipTouchStart"
        catchtouchmove="onChipTouchMove"
        bindtouchend="onChipTouchEnd"
        bindtouchcancel="onChipTouchEnd"
      >
        <view class="chip-dot" style="background:{{item.color}}"></view>{{item.name}}
      </view>
      <view wx:if="{{courseLib[libCategory].length === 0}}" class="lib-empty-cat">这个分类还没有课程，去「管理」添加</view>
    </scroll-view>
  </block>
  <view wx:else class="lib-empty">
    <view class="lib-empty-txt">还没有课程哦</view>
    <view class="lib-empty-btn" bindtap="goCourseLibrary">去课程库添加</view>
  </view>
</view>

<!-- 拖拽跟随的浮层 -->
<view
  wx:if="{{dragGhost.show}}"
  class="drag-ghost"
  style="left:{{dragGhost.x}}px;top:{{dragGhost.y}}px;background:{{dragGhost.color}}"
>{{dragGhost.label}}</view>
