/* pages/schedule/index.wxss —— 课表 */
.day-block {
  margin-bottom: 20rpx;
}
.day-head {
  display: flex;
  align-items: center;
  margin: 12rpx 4rpx 16rpx;
}
.day-label {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--primary-dark);
  margin-right: 20rpx;
}
.day-line {
  flex: 1;
  height: 2rpx;
  background: var(--line);
}
.empty-day {
  font-size: 26rpx;
  padding: 8rpx 8rpx 20rpx;
}

.course-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
}
.time-col {
  width: 110rpx;
  flex-shrink: 0;
}
.time-start {
  font-size: 30rpx;
  font-weight: 600;
}
.time-end {
  font-size: 24rpx;
  margin-top: 4rpx;
}
.course-line {
  width: 8rpx;
  align-self: stretch;
  border-radius: 8rpx;
  margin: 0 20rpx;
}
.course-name {
  font-size: 32rpx;
  font-weight: 600;
}
.course-meta {
  font-size: 24rpx;
  margin-top: 8rpx;
}
.type-tag {
  color: var(--primary-dark);
}
.del-btn {
  font-size: 24rpx;
  color: var(--ink-weak);
  padding: 4rpx 12rpx;
}

/* 弹层 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 30;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  z-index: 31;
}
.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 28rpx;
}
.sheet-input {
  background: var(--bg);
  border-radius: var(--radius);
  padding: 24rpx;
  font-size: 30rpx;
  margin-bottom: 20rpx;
}
.ph {
  color: var(--ink-weak);
}
.sheet-field {
  padding: 20rpx 8rpx;
  border-bottom: 2rpx solid var(--line);
}
.sheet-field-label {
  font-size: 28rpx;
  font-weight: 600;
}
.picker-val {
  font-size: 30rpx;
  color: var(--primary-dark);
}
.time-sep {
  margin: 0 16rpx;
}
.sheet-actions {
  margin-top: 32rpx;
}
.sheet-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
}
.sheet-btn:first-child {
  margin-right: 20rpx;
}
