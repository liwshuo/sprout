/* pages/schedule/index.wxss —— 课表 */
.day-block {
  margin-bottom: 20rpx;
}
.day-head {
  display: flex;
  align-items: center;
  margin: 12rpx 4rpx 16rpx;
}
.day-label {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--primary-dark);
  margin-right: 20rpx;
}
.day-line {
  flex: 1;
  height: 2rpx;
  background: var(--line);
}
.empty-day {
  font-size: 26rpx;
  padding: 8rpx 8rpx 20rpx;
}

.course-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
}
.course-card-off {
  opacity: 0.45;
  position: relative;
}
.course-card-off::after {
  content: '';
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  top: 50%;
  height: 3rpx;
  background: #B0A79E;
  transform: rotate(-4deg);
}
.course-name-row {
  align-items: center;
}
.off-badge {
  margin-left: 12rpx;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #F2ECE6;
  color: #8A7D70;
  flex-shrink: 0;
}
.time-col {
  width: 110rpx;
  flex-shrink: 0;
}
.time-start {
  font-size: 30rpx;
  font-weight: 600;
}
.time-end {
  font-size: 24rpx;
  margin-top: 4rpx;
}
.course-line {
  width: 8rpx;
  align-self: stretch;
  border-radius: 8rpx;
  margin: 0 20rpx;
}
.course-name {
  font-size: 32rpx;
  font-weight: 600;
  flex: 1;
}
.course-meta {
  font-size: 24rpx;
  margin-top: 8rpx;
}
.type-tag {
  color: var(--primary-dark);
}
.course-range {
  font-size: 22rpx;
  margin-top: 6rpx;
}
.course-actions {
  display: flex;
  align-items: center;
  margin-left: 12rpx;
  flex-shrink: 0;
}
.edit-btn {
  font-size: 24rpx;
  color: #3C78A8;
  padding: 4rpx 12rpx;
  margin-right: 4rpx;
}
.del-btn {
  font-size: 24rpx;
  color: var(--ink-weak);
  padding: 4rpx 12rpx;
}

/* 弹层自定义元素样式（通用 mask/sheet 由 bottom-sheet 组件提供） */
.sheet-input {
  background: #F5EFE9;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 30rpx;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}
.ph {
  color: #B0A79E;
}
.sheet-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 8rpx;
  border-bottom: 2rpx solid #EFE7DE;
}
.sheet-field-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #2E2722;
}
.picker-val {
  font-size: 30rpx;
  color: #FF8C42;
}
.time-sep {
  margin: 0 16rpx;
}
.row-label {
  display: block;
  padding: 16rpx 8rpx 8rpx;
}
.type-chip-row {
  display: flex;
  margin: 8rpx 0 16rpx;
}
.type-chip {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: var(--radius-pill);
  background: var(--bg);
  font-size: 28rpx;
  color: var(--ink-sub);
  margin-right: 16rpx;
}
.type-chip:last-child {
  margin-right: 0;
}
.type-chip-active {
  color: #fff;
  font-weight: 600;
}
.type-chip-school {
  background: #3C78A8;
}
.type-chip-extra {
  background: #FF8C42;
}
.today-off-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 8rpx;
  border-bottom: 2rpx solid var(--line);
  margin-bottom: 16rpx;
}
.today-off-label {
  display: flex;
  flex-direction: column;
}
.today-off-title {
  font-size: 28rpx;
  font-weight: 600;
}
.today-off-sub {
  font-size: 22rpx;
  margin-top: 6rpx;
}
.sheet-btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}
.list-footer {
  height: 120rpx;
}
.skeleton .sk-day-block {
  margin-bottom: 20rpx;
}
.skeleton .sk-line {
  height: 20rpx;
  border-radius: 8rpx;
  background: var(--line);
  margin: 12rpx 0;
}
.skeleton .sk-line.short { width: 40%; }
