/* pages/schedule/index.wxss —— 课表：周网格 / 日视图 */

/* 顶部工具条 */
.sched-toolbar {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 8rpx 4rpx 4rpx;
}
.toolbar-titles { flex: 1; min-width: 0; }
.view-seg {
  display: flex;
  background: #F0EBE4;
  border-radius: 999rpx;
  padding: 4rpx;
  flex-shrink: 0;
}
.seg-item {
  width: 72rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--ink-sub);
  border-radius: 999rpx;
}
.seg-on {
  background: #fff;
  color: #FF8C42;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

/* 图例 */
.legend {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 14rpx 4rpx 12rpx;
  font-size: 24rpx;
  color: var(--ink-sub);
}
.legend-item { display: flex; align-items: center; }
.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
}
.dot-school { background: #8FC7F0; }
.dot-hobby { background: #FF8C42; }
.legend-lib {
  margin-left: auto;
  font-size: 24rpx;
  color: #E5702A;
  background: #FFF3EB;
  border: 2rpx solid #FFD9BE;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}
.legend-lib.on { background: #FF8C42; color: #fff; border-color: #FF8C42; }

/* ===== 网格通用 ===== */
.week-scroll {
  width: 100%;
  white-space: nowrap;
  background: #fff;
  border-radius: 20rpx;
  padding: 0 0 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}
.grid {
  width: 1120rpx;            /* 70(时间轴) + 7*150 */
  display: flex;
  flex-direction: column;
}
.ghead {
  display: flex;
  position: sticky;
  top: 0;
  z-index: 5;
  background: #fff;
  border-bottom: 2rpx solid #EFE7DE;
}
.gcorner { width: 70rpx; flex-shrink: 0; }
.dhead {
  width: 150rpx;
  flex-shrink: 0;
  text-align: center;
  padding: 14rpx 0 12rpx;
}
.dhead-wd { font-size: 26rpx; font-weight: 600; color: #2E2722; }
.dhead-dt { font-size: 22rpx; color: #B0A79E; margin-top: 4rpx; }
.dhead.today {
  background: #FFF3EB;
  border-top-left-radius: 12rpx;
  border-top-right-radius: 12rpx;
}
.dhead.today .dhead-wd { color: #E5702A; }
.dhead.today .dhead-dt { color: #E5702A; }

.gbody { display: flex; position: relative; }
.timecol { width: 70rpx; flex-shrink: 0; position: relative; }
.th {
  position: absolute;
  right: 8rpx;
  transform: translateY(-50%);
  font-size: 20rpx;
  color: #B0A79E;
}
.th:first-child { transform: none; top: 0 !important; }

.daycol {
  width: 150rpx;
  flex-shrink: 0;
  position: relative;
  border-left: 2rpx solid #F2ECE4;
}
.daycol.today { background: #FFFBF7; }
.daycol-full { width: 680rpx; }
.hline {
  position: absolute;
  left: 0;
  right: 0;
  height: 0;
  border-top: 2rpx dashed #F0E9E1;
}

/* 课程色块 */
.ev {
  position: absolute;
  left: 6rpx;
  right: 6rpx;
  border-radius: 10rpx;
  padding: 6rpx 8rpx;
  overflow: hidden;
  box-sizing: border-box;
  color: #fff;
}
.ev-school { background: #6FB0E3; }
.ev-hobby { background: #FF8C42; }
.ev-nm {
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.ev-tm { font-size: 18rpx; opacity: 0.9; margin-top: 2rpx; }
.ev-off {
  font-size: 18rpx;
  margin-top: 2rpx;
  background: rgba(255,255,255,0.25);
  border-radius: 6rpx;
  padding: 0 6rpx;
  display: inline-block;
}
.ev.ev-off { opacity: 0.5; }

/* 日视图 */
.daytabs {
  display: flex;
  gap: 10rpx;
  overflow-x: auto;
  white-space: nowrap;
  padding: 12rpx 0 16rpx;
}
.daytab {
  flex-shrink: 0;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #F0EBE4;
  font-size: 26rpx;
  color: var(--ink-sub);
}
.daytab-on { background: #FF8C42; color: #fff; font-weight: 600; }
.daytab-today { border: 2rpx solid #FF8C42; }
.daytab-today.daytab-on { border-color: #FF8C42; }
.day-empty {
  font-size: 26rpx;
  color: #B0A79E;
  text-align: center;
  padding: 8rpx 0 16rpx;
}
.day-body {
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  overflow: hidden;
}

/* 编辑弹层里的删除入口 */
.sheet-delete {
  text-align: center;
  color: #C0392B;
  font-size: 28rpx;
  padding: 20rpx 0 8rpx;
}

/* 弹层自定义元素样式（通用 mask/sheet 由 bottom-sheet 组件提供） */
.sheet-input {
  background: #F5EFE9;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 30rpx;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}
.ph {
  color: #B0A79E;
}
.sheet-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 8rpx;
  border-bottom: 2rpx solid #EFE7DE;
}
.sheet-field-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #2E2722;
}
.picker-val {
  font-size: 30rpx;
  color: #FF8C42;
}
.time-sep {
  margin: 0 16rpx;
}
.row-label {
  display: block;
  padding: 16rpx 8rpx 8rpx;
}
.type-chip-row {
  display: flex;
  margin: 8rpx 0 16rpx;
}
.type-chip {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: var(--radius-pill);
  background: var(--bg);
  font-size: 28rpx;
  color: var(--ink-sub);
  margin-right: 16rpx;
}
.type-chip:last-child {
  margin-right: 0;
}
.type-chip-active {
  color: #fff;
  font-weight: 600;
}
.type-chip-school {
  background: #3C78A8;
}
.type-chip-extra {
  background: #FF8C42;
}
.today-off-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 8rpx;
  border-bottom: 2rpx solid var(--line);
  margin-bottom: 16rpx;
}
.today-off-label {
  display: flex;
  flex-direction: column;
}
.today-off-title {
  font-size: 28rpx;
  font-weight: 600;
}
.today-off-sub {
  font-size: 22rpx;
  margin-top: 6rpx;
}
.sheet-btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}
.list-footer {
  height: 120rpx;
}
.skeleton .sk-day-block {
  margin-bottom: 20rpx;
}
.skeleton .sk-line {
  height: 20rpx;
  border-radius: 8rpx;
  background: var(--line);
  margin: 12rpx 0;
}
.skeleton .sk-line.short { width: 40%; }


/* ===== 拖拽落点提示 ===== */
.drop-hint {
  position: absolute;
  left: 6rpx;
  right: 6rpx;
  border-radius: 10rpx;
  border: 3rpx dashed #FF8C42;
  background: rgba(255, 140, 66, 0.14);
  color: #E5702A;
  font-size: 20rpx;
  line-height: 1.4;
  padding: 4rpx 6rpx;
  box-sizing: border-box;
  z-index: 3;
}

/* ===== 课程库面板（固定底部） ===== */
.lib-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.12);
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  transform: translateY(120%);
  transition: transform 0.24s ease;
  z-index: 60;
}
.lib-panel.lib-open { transform: translateY(0); }
.lib-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.lib-tabs {
  display: flex;
  background: #F0EBE4;
  border-radius: 999rpx;
  padding: 4rpx;
}
.lib-tab {
  padding: 8rpx 30rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--ink-sub);
}
.lib-tab-on { background: #fff; color: #FF8C42; font-weight: 700; }
.lib-close { font-size: 26rpx; color: var(--ink-sub); padding: 8rpx 8rpx 8rpx 24rpx; }
.lib-manage { font-size: 26rpx; color: #E5702A; padding: 8rpx 8rpx 8rpx 24rpx; }
.lib-tip { font-size: 22rpx; color: #B0A79E; margin: 12rpx 2rpx; }
.lib-chips {
  max-height: 260rpx;
  white-space: normal;
}
.chip {
  display: inline-flex;
  align-items: center;
  margin: 0 14rpx 14rpx 0;
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #3A3F4A;
  background: #F6F4EF;
  border: 2rpx solid #EAE4DB;
}
.chip-dot { width: 20rpx; height: 20rpx; border-radius: 50%; margin-right: 12rpx; }
.lib-empty-cat { font-size: 24rpx; color: #B0A79E; padding: 12rpx 4rpx; }
.lib-empty { text-align: center; padding: 16rpx 0 8rpx; }
.lib-empty-txt { font-size: 26rpx; color: #B0A79E; margin-bottom: 16rpx; }
.lib-empty-btn {
  display: inline-block;
  padding: 14rpx 40rpx;
  border-radius: 999rpx;
  background: #FF8C42;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

/* ===== 拖拽跟随浮层 ===== */
.drag-ghost {
  position: fixed;
  transform: translate(-50%, -50%);
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.22);
  z-index: 200;
  pointer-events: none;
  opacity: 0.94;
}
.ghost-school { background: #6FB0E3; }
.ghost-hobby { background: #FF8C42; }
