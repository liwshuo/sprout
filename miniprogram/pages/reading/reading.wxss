/* pages/reading/reading.wxss —— 阅读书架 */
.tab-bar {
  display: flex;
  background: #fff;
  border-radius: var(--radius-pill);
  padding: 8rpx;
  margin-bottom: 28rpx;
  box-shadow: var(--shadow);
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: var(--ink-sub);
  border-radius: var(--radius-pill);
}
.tab.active {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: #fff;
  font-weight: 600;
}

.book-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.book-card {
  width: 31%;
  margin-bottom: 32rpx;
}
.cover {
  position: relative;
  width: 100%;
  height: 300rpx;
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow);
  background: var(--primary-soft);
}
.cover-img {
  width: 100%;
  height: 100%;
}
.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: var(--primary-dark);
  font-weight: 600;
}
.status-badge {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  font-size: 20rpx;
  color: #fff;
}
.status-want { background: var(--sky); }
.status-reading { background: var(--primary); }
.status-done { background: var(--mint); }

.book-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 12rpx;
}
.book-author {
  font-size: 22rpx;
  margin-top: 4rpx;
}
/* 打卡按钮 */
.checkin-btn {
  margin-top: 12rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary-dark);
  background: var(--primary-soft);
  border-radius: var(--radius-pill);
  padding: 10rpx 0;
}
.checkin-btn:active {
  opacity: 0.75;
}

/* 弹层 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 50;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  z-index: 51;
}
.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 28rpx;
}
.sheet-input {
  background: var(--bg);
  border-radius: var(--radius);
  padding: 24rpx;
  font-size: 30rpx;
  margin-bottom: 20rpx;
}
.ph {
  color: var(--ink-weak);
}
.sheet-actions {
  margin-top: 12rpx;
}
.sheet-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
}
.sheet-btn:first-child {
  margin-right: 20rpx;
}

/* 打卡弹层专用 */
.checkin-row {
  display: flex;
}
.checkin-half:first-child {
  margin-right: 20rpx;
}
.checkin-note {
  min-height: 120rpx;
}
.sheet-field {
  padding: 20rpx 8rpx;
  border-bottom: 2rpx solid var(--line);
  margin-bottom: 12rpx;
}
.sheet-field-label {
  font-size: 28rpx;
  font-weight: 600;
}
.picker-val {
  font-size: 30rpx;
  color: var(--primary-dark);
}


/* ============================================================
   系列书面板 & 系列卡片（暖橙马卡龙 · 大圆角）
   z-index 规范：打卡 sheet(51) > 系列面板(41) > mask(50)/系列 mask(40)
   ============================================================ */

/* ---- 系列卡片：三层叠层封面伪装 ---- */
.series-stack {
  overflow: visible;
  background: transparent;
  box-shadow: none;
}
.stack-layer {
  position: absolute;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}
.stack-3 {
  top: -14rpx;
  left: 14rpx;
  right: -14rpx;
  bottom: 14rpx;
  background: #ffd9b8;
  z-index: 1;
}
.stack-2 {
  top: -7rpx;
  left: 7rpx;
  right: -7rpx;
  bottom: 7rpx;
  background: var(--primary-light);
  z-index: 2;
}
.stack-1 {
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--primary-soft);
  overflow: hidden;
  z-index: 3;
}
/* 「系列」橙色徽标（右上角） */
.series-badge {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  z-index: 4;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  font-size: 20rpx;
  color: #fff;
  background: var(--primary);
  box-shadow: var(--shadow-primary);
}

/* ---- 进度条（暖橙渐变） ---- */
.series-progress {
  margin-top: 10rpx;
}
.progress-track {
  height: 12rpx;
  background: var(--line);
  border-radius: 4px;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary-light), var(--primary));
  border-radius: 4px;
}
.progress-text {
  font-size: 20rpx;
  margin-top: 6rpx;
}

/* ---- 添加方式选择弹层 ---- */
.choice-item {
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  background: var(--bg);
  border-radius: var(--radius);
  margin-bottom: 16rpx;
}
.choice-item:active {
  opacity: 0.8;
}
.choice-cancel {
  color: var(--ink-sub);
  background: transparent;
  margin-bottom: 0;
}

/* ---- 扫码确认：封面预览 ---- */
.scan-preview {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}
.scan-cover {
  width: 180rpx;
  height: 240rpx;
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  background: var(--primary-soft);
}
.scan-cover-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink-weak);
  font-size: 24rpx;
}
.scan-isbn {
  font-size: 22rpx;
  margin-top: 12rpx;
}

/* ---- 系列面板 sheet（层级低于打卡 sheet、高于普通 mask） ---- */
.series-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 40;
}
.series-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  z-index: 41;
  max-height: 82vh;
  display: flex;
  flex-direction: column;
}
.series-panel-head {
  margin-bottom: 20rpx;
}
.series-panel-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}
.series-panel-progress .progress-track {
  height: 16rpx;
}
.series-panel-progress .progress-text {
  font-size: 22rpx;
}

/* ---- 分册列表 ---- */
.volume-list {
  flex: 1;
  max-height: 52vh;
}
.volume-row {
  display: flex;
  align-items: center;
  padding: 22rpx 8rpx;
  border-bottom: 2rpx solid var(--line);
}
.volume-index {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary-dark);
  margin-right: 16rpx;
  white-space: nowrap;
}
.volume-title {
  font-size: 28rpx;
}
.volume-status {
  font-size: 20rpx;
  color: #fff;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  margin: 0 16rpx;
  white-space: nowrap;
}
.volume-btn {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary-dark);
  background: var(--primary-soft);
  border-radius: var(--radius-pill);
  padding: 8rpx 24rpx;
  white-space: nowrap;
}
.volume-btn:active {
  opacity: 0.75;
}
.volume-empty {
  text-align: center;
  padding: 56rpx 0;
  font-size: 26rpx;
}
.series-add-btn {
  margin-top: 24rpx;
}
