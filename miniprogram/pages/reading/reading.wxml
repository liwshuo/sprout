<!-- pages/reading/reading.wxml —— 阅读书架 -->
<view class="container">
  <view class="page-title">阅读书架</view>
  <view class="page-subtitle">陪孩子一起读过的每一本好书</view>

  <!-- 状态筛选 -->
  <view class="tab-bar">
    <view
      class="tab {{activeTab === item.key ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="switchTab"
    >{{item.label}}</view>
  </view>

  <view class="empty card" wx:if="{{!loading && renderList.length === 0}}">
    <text class="empty-emoji">📚</text>
    <view class="empty-text">书架还空着，点右下角添加第一本书</view>
  </view>

  <!-- 书籍/系列网格 -->
  <view class="book-grid">
    <block wx:for="{{renderList}}" wx:key="key">
      <!-- 系列卡片 -->
      <view wx:if="{{item.isSeries}}" class="book-card" data-uuid="{{item.seriesUuid}}" bindtap="openSeries">
        <view class="cover series-stack">
          <view class="stack-layer stack-3"></view>
          <view class="stack-layer stack-2"></view>
          <view class="stack-layer stack-1">
            <image wx:if="{{item.covers[0]}}" class="cover-img" src="{{item.covers[0]}}" mode="aspectFill" />
            <view wx:else class="cover-placeholder">{{item.name}}</view>
          </view>
          <view class="series-badge">系列</view>
        </view>
        <view class="book-title ellipsis">{{item.name}}</view>
        <view class="series-progress">
          <view class="progress-track">
            <view class="progress-fill" style="width:{{item.progress.total ? (item.progress.done * 100 / item.progress.total) : 0}}%"></view>
          </view>
          <view class="progress-text text-sub">已读 {{item.progress.done}}/{{item.progress.total}}</view>
        </view>
      </view>

      <!-- 单本书卡片 -->
      <view wx:else class="book-card">
        <view class="cover" data-uuid="{{item.uuid}}" bindtap="cycleStatus">
          <image wx:if="{{item.coverUrl}}" class="cover-img" src="{{item.coverUrl}}" mode="aspectFill" />
          <view wx:else class="cover-placeholder">{{item.title}}</view>
          <view class="status-badge status-{{item.status}}">{{item.statusLabel}}</view>
        </view>
        <view class="book-title ellipsis">{{item.title}}</view>
        <view class="book-author ellipsis text-sub" wx:if="{{item.author}}">{{item.author}}</view>
        <view class="checkin-btn" data-uuid="{{item.uuid}}" data-title="{{item.title}}" catchtap="openCheckin">📖 打卡</view>
      </view>
    </block>
  </view>
</view>

<view class="fab" bindtap="openAddChoice">＋</view>

<!-- 添加方式选择弹层 -->
<view class="mask" wx:if="{{showAddChoice}}" bindtap="closeAddChoice"></view>
<view class="sheet" wx:if="{{showAddChoice}}" catchtap>
  <view class="sheet-title">添加书籍</view>
  <view class="choice-item" bindtap="goLibrary">📚 精选书库</view>
  <view class="choice-item" bindtap="chooseManual">✍️ 手动录入</view>
  <view class="choice-item" bindtap="chooseScan">📷 扫码添加</view>
  <view class="choice-item" bindtap="chooseCreateSeries">📚 新建系列</view>
  <view class="choice-item choice-cancel" bindtap="closeAddChoice">取消</view>
</view>

<!-- 手动新增书籍弹层 -->
<view class="mask" wx:if="{{showAdd}}" bindtap="closeAdd"></view>
<view class="sheet" wx:if="{{showAdd}}" catchtap>
  <view class="sheet-title">添加书籍</view>
  <input class="sheet-input" placeholder="书名" placeholder-class="ph" data-field="title" value="{{form.title}}" bindinput="onFormInput" />
  <input class="sheet-input" placeholder="作者（选填）" placeholder-class="ph" data-field="author" value="{{form.author}}" bindinput="onFormInput" />
  <view class="row sheet-actions">
    <view class="btn-ghost sheet-btn" bindtap="closeAdd">取消</view>
    <view class="btn-primary sheet-btn" bindtap="saveBook">加入书架</view>
  </view>
</view>

<!-- 扫码确认弹层 -->
<view class="mask" wx:if="{{showScanConfirm}}" bindtap="closeScanConfirm"></view>
<view class="sheet" wx:if="{{showScanConfirm}}" catchtap>
  <view class="sheet-title">确认书籍信息</view>
  <view class="scan-preview">
    <image wx:if="{{scanForm.cover}}" class="scan-cover" src="{{scanForm.cover}}" mode="aspectFill" />
    <view wx:else class="scan-cover scan-cover-ph">无封面</view>
    <view class="scan-isbn text-sub">ISBN：{{scanForm.isbn}}</view>
  </view>
  <input class="sheet-input" placeholder="书名" placeholder-class="ph" data-field="title" value="{{scanForm.title}}" bindinput="onScanInput" />
  <input class="sheet-input" placeholder="作者（选填）" placeholder-class="ph" data-field="author" value="{{scanForm.author}}" bindinput="onScanInput" />
  <input class="sheet-input" type="number" placeholder="总页数（选填）" placeholder-class="ph" data-field="totalPages" value="{{scanForm.totalPages}}" bindinput="onScanInput" />
  <view class="row sheet-actions">
    <view class="btn-ghost sheet-btn" bindtap="closeScanConfirm">取消</view>
    <view class="btn-primary sheet-btn" bindtap="saveScanBook">保存</view>
  </view>
</view>

<!-- 新建系列弹层 -->
<view class="mask" wx:if="{{showCreateSeries}}" bindtap="closeCreateSeries"></view>
<view class="sheet" wx:if="{{showCreateSeries}}" catchtap>
  <view class="sheet-title">新建系列</view>
  <input class="sheet-input" placeholder="系列名（如 神奇校车）" placeholder-class="ph" data-field="name" value="{{seriesForm.name}}" bindinput="onSeriesFormInput" />
  <input class="sheet-input" type="number" placeholder="总册数（选填）" placeholder-class="ph" data-field="totalVolumes" value="{{seriesForm.totalVolumes}}" bindinput="onSeriesFormInput" />
  <view class="row sheet-actions">
    <view class="btn-ghost sheet-btn" bindtap="closeCreateSeries">取消</view>
    <view class="btn-primary sheet-btn" bindtap="saveCreateSeries">创建</view>
  </view>
</view>

<!-- 系列面板 -->
<view class="series-mask" wx:if="{{showSeriesPanel}}" bindtap="closeSeries"></view>
<view class="series-sheet" wx:if="{{showSeriesPanel}}" catchtap>
  <view class="series-panel-head">
    <view class="series-panel-title ellipsis">{{seriesPanel.name}}</view>
    <view class="series-panel-progress">
      <view class="progress-track">
        <view class="progress-fill" style="width:{{seriesPanel.progress.total ? (seriesPanel.progress.done * 100 / seriesPanel.progress.total) : 0}}%"></view>
      </view>
      <view class="progress-text text-sub">已读 {{seriesPanel.progress.done}}/{{seriesPanel.progress.total}}</view>
    </view>
  </view>

  <scroll-view scroll-y class="volume-list">
    <view class="volume-row" wx:for="{{seriesPanel.volumes}}" wx:key="uuid">
      <view class="volume-index">{{item.indexLabel}}</view>
      <view class="volume-title ellipsis flex-1">{{item.title}}</view>
      <view class="volume-status status-{{item.status}}">{{item.statusLabel}}</view>
      <view class="volume-btn" data-uuid="{{item.uuid}}" data-title="{{item.title}}" data-from="series" catchtap="openCheckin">打卡</view>
    </view>
    <view class="volume-empty text-sub" wx:if="{{seriesPanel.volumes.length === 0}}">还没有分册，点下方添加</view>
  </scroll-view>

  <view class="btn-primary btn-block series-add-btn" data-uuid="{{seriesPanel.seriesUuid}}" bindtap="addVolume">＋ 添加分册</view>
</view>

<!-- 阅读打卡弹层 -->
<view class="mask" wx:if="{{showCheckin}}" bindtap="closeCheckin"></view>
<view class="sheet {{showCheckin ? 'sheet-show' : ''}}" wx:if="{{showCheckin}}" catchtap>
  <view class="sheet-title">阅读打卡 · {{checkinBookTitle}}</view>

  <view class="row checkin-row">
    <input
      class="sheet-input flex-1 checkin-half"
      type="number"
      placeholder="起始页（选填）"
      placeholder-class="ph"
      data-field="pageFrom"
      bindinput="onCheckinInput"
      value="{{checkinForm.pageFrom}}"
    />
    <input
      class="sheet-input flex-1 checkin-half"
      type="number"
      placeholder="结束页（选填）"
      placeholder-class="ph"
      data-field="pageTo"
      bindinput="onCheckinInput"
      value="{{checkinForm.pageTo}}"
    />
  </view>
  <input
    class="sheet-input"
    placeholder="章节（选填，如 第 3 章）"
    placeholder-class="ph"
    data-field="chapter"
    bindinput="onCheckinInput"
    value="{{checkinForm.chapter}}"
  />
  <textarea
    class="sheet-input checkin-note"
    placeholder="读书心得（选填）"
    placeholder-class="ph"
    data-field="note"
    bindinput="onCheckinInput"
    value="{{checkinForm.note}}"
    auto-height
  />

  <view class="row-between sheet-field">
    <view class="sheet-field-label">日期</view>
    <picker mode="date" value="{{checkinForm.date}}" bindchange="onCheckinDateChange">
      <view class="picker-val">{{checkinForm.date}} ›</view>
    </picker>
  </view>

  <view class="row sheet-actions">
    <view class="btn-ghost sheet-btn" bindtap="closeCheckin">取消</view>
    <view class="btn-primary sheet-btn" bindtap="saveCheckin">保存打卡</view>
  </view>
</view>
