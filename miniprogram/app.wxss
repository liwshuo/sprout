/* app.wxss - 全局样式 */

page {
  /* 暖橙主色调 */
  --primary-color: #FF8C42;
  --primary-light: #FFB07C;
  --primary-dark: #E5702A;
  --bg-color: #FFF7F0;
  --card-bg: #FFFFFF;
  --text-main: #333333;
  --text-sub: #999999;

  background-color: var(--bg-color);
  color: var(--text-main);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
  font-size: 28rpx;
}

.container {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.page-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--primary-color);
  margin-bottom: 24rpx;
}

.card {
  background-color: var(--card-bg);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 140, 66, 0.08);
}

.btn-primary {
  background-color: var(--primary-color);
  color: #FFFFFF;
  border-radius: 48rpx;
}
