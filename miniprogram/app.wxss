/* app.wxss —— 全局样式：暖橙马卡龙色系 · 大圆角 · CSS 变量设计令牌 */

page {
  /* ===== 主色（暖橙）===== */
  --primary: #FF8C42;
  --primary-dark: #E5702A;
  --primary-light: #FFB07C;
  --primary-soft: #FFE7CF;

  /* ===== 背景 / 卡片 ===== */
  --bg: #FFF8F3;
  --card: #FFFFFF;

  /* ===== 文字 / 描边 ===== */
  --ink: #4A4038;
  --ink-sub: #9A8F82;
  --ink-weak: #C4BAB0;
  --line: #F0E7D8;

  /* ===== 辅助马卡龙色（对齐 Flutter 分类色）===== */
  --mint: #7ED9C3;
  --sky: #8FC7F0;
  --pink: #FF9EB5;
  --lilac: #B7A5F0;

  /* ===== 圆角 / 阴影 ===== */
  --radius: 24rpx;
  --radius-lg: 32rpx;
  --radius-pill: 999rpx;
  --shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  --shadow-primary: 0 8rpx 24rpx rgba(255, 140, 66, 0.28);

  background-color: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
  font-size: 30rpx;
  line-height: 1.6;
}

/* ============ 布局容器 ============ */
.container {
  min-height: 100vh;
  padding: 32rpx 28rpx;
  box-sizing: border-box;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--ink-sub);
  margin-bottom: 28rpx;
}

/* ============ 卡片 ============ */
.card {
  background-color: var(--card);
  border-radius: var(--radius);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}

.card-lg {
  border-radius: var(--radius-lg);
}

/* ============ 按钮 ============ */
.btn-primary {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: #ffffff;
  border-radius: var(--radius-pill);
  font-weight: 600;
  box-shadow: var(--shadow-primary);
  border: none;
}
.btn-primary::after {
  border: none;
}

.btn-ghost {
  background: var(--primary-soft);
  color: var(--primary-dark);
  border-radius: var(--radius-pill);
  font-weight: 600;
  border: none;
}
.btn-ghost::after {
  border: none;
}

.btn-block {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 32rpx;
  text-align: center;
}

/* ============ 标签 chip ============ */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  background: var(--primary-soft);
  color: var(--primary-dark);
  margin-right: 12rpx;
}

/* ============ 空态 ============ */
.empty {
  text-align: center;
  padding: 96rpx 0;
  color: var(--ink-sub);
}
.empty-emoji {
  font-size: 88rpx;
  display: block;
  margin-bottom: 20rpx;
}
.empty-text {
  font-size: 28rpx;
}

/* ============ 悬浮添加按钮 FAB ============ */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: #ffffff;
  font-size: 64rpx;
  line-height: 108rpx;
  text-align: center;
  box-shadow: var(--shadow-primary);
  z-index: 20;
}

/* ============ 通用工具类 ============ */
.row {
  display: flex;
  align-items: center;
}
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.col {
  display: flex;
  flex-direction: column;
}
.flex-1 {
  flex: 1;
  min-width: 0;
}
.text-sub {
  color: var(--ink-sub);
}
.text-primary {
  color: var(--primary);
}
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
